# Copy to .env.local for local dev, or set in Vercel → Project → Settings → Environment Variables.
# See README.md for where each value comes from in the Supabase dashboard.
# Never commit real values. Never put service_role in a VITE_* variable.

# Supabase API URL (Dashboard → Project Settings → API → Project URL).
# Local CLI default after `npx supabase start`:
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Browser key: Dashboard → API → anon / publishable key.
# Local: `npx supabase status` → anon key.
# Legacy server aliases: VITE_SUPABASE_ANON_KEY, VITE_SUPABASE_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: show Google on /login and /signup (also enable Google in Supabase Auth providers).
VITE_AUTH_GOOGLE_ENABLED=false

# Public origin of this app, no trailing slash. Server-only (not exposed as VITE_*).
# Auth email links (signup confirm, password reset). Local: http://localhost:3000
APP_URL=http://localhost:3000

# Server-only. Required for Admin → Users (create/delete, password and email changes).
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. JWT signing secret for API/MCP personal access tokens (short-lived user JWT).
# Local: `npx supabase status` → JWT secret. Hosted: Dashboard → Project Settings → API → JWT Keys.
SUPABASE_JWT_SECRET=

# Server-only. HMAC secret for signed admin media upload tickets (32+ random characters).
# Generate with: npm run secrets:generate
MEDIA_UPLOAD_TICKET_SECRET=
# Server-only. HMAC secret for hashing contact form IPs (rate limit). Required in production.
# Generate with: npm run secrets:generate
CONTACT_IP_HASH_SECRET=

# Optional. Contact form messages are always saved to Admin > Inbox.
# Set both to also email each message to the contact email in Admin > Settings.
# Resend API key (resend.com > API Keys) and a sender on a verified domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
